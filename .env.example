# Copy this file to .env.local in the repository root and fill in your values.
# Use plain values without quotation marks. .env.local is ignored by Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# A legacy SUPABASE_SERVICE_ROLE_KEY can be used instead of SUPABASE_SECRET_KEY.

# Optional: required only for the private meter-ingestion endpoint.
METERING_TOKEN=
